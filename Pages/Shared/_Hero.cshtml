<!-- HERO COMPONENT (CENTRAL TRANSFORMATION STAGE - TRANSPARENT OUTER, INNER CARDS) -->
<div class="hero hero-designali">
    <div class="wrap hero-center-container">
        <!-- Main Headline -->
        <h1 class="hero-title">
            Manufacturing-ready designs. <span class="hero-gradient-text">In minutes!</span>
        </h1>

        <!-- Clean 1-Line Value Proposition Subtitle -->
        <p class="hero-lead">
            Turn your design requirements into manufacturing-ready drawings and BOMs, automatically.
        </p>

        <!-- Central Before-and-After Transformation Stage (Transparent Outer, Clean Floating Inner Cards) -->
        <div class="hero-transform-stage">
            <!-- Left Card: Complete Engineering Requirements Package -->
            <div class="transform-card card-sketch">
                <!-- 1. Top Requirements Header -->
                <div class="card-req-topbar">
                    <span class="card-req-tag mono">
                        <i class="bi bi-sliders"></i> 01 / DESIGN INPUTS
                    </span>
                    <span class="card-req-badge mono">REQUIREMENTS</span>
                </div>

                <!-- 2. Customer Design Intent (Plain English Brief) -->
                @* <div class="card-req-intent">
                    <span class="intent-lbl mono"><i class="bi bi-chat-square-text"></i> DESIGN INTENT</span>
                    <p class="intent-txt">
                        Heavy-duty foot-mounted bearing housing for continuous conveyor shaft support.
                    </p>
                </div> *@

                <!-- 3. Key Engineering Parameter Specs (4 Axial Fan Inputs) -->
                <div class="card-req-specs mono">
                    <div class="req-spec-pill">
                        <span class="spec-k">AIR FLOW</span>
                        <span class="spec-v">25,000 m&sup3;/h</span>
                    </div>
                    <div class="req-spec-pill">
                        <span class="spec-k">PRESSURE</span>
                        <span class="spec-v">450 Pa</span>
                    </div>
                    <div class="req-spec-pill">
                        <span class="spec-k">TEMPERATURE</span>
                        <span class="spec-v">60&deg;C</span>
                    </div>
                    <div class="req-spec-pill">
                        <span class="spec-k">SPEED</span>
                        <span class="spec-v">1,450 RPM</span>
                    </div>
                </div>

                <!-- 4. Automated Verification Status Footer -->
                @* <div class="card-req-footer mono">
                    <span class="pulse-dot"></span> SIZING RULES VALIDATED
                </div> *@
            </div>

            <!-- Transformation Flow Arrow (Crisp Vector SVG Badge) -->
            <div class="transform-arrow" aria-hidden="true">
                <div class="transform-arrow-badge">
                    <svg class="transform-arrow-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <polyline points="13 5 20 12 13 19"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Right Card: 3D Solid Model, 2D Drawing, and BOM Deliverables -->
            <div class="transform-card card-deliverables">
                <!-- Top Deliverables Header with matching Pill Badge -->
                <div class="card-req-topbar">
                    <span class="card-req-tag mono">
                        <i class="bi bi-box-seam"></i> 02 / DESIGN OUTPUTS
                    </span>
                    <span class="card-req-badge mono">OUTPUTS</span>
                </div>

                <img src="~/images/hero_card_deliverables_fan.png" 
                     alt="Axial Fan 3D CAD solid model, 2D manufacturing drawings, and BOM sheet" 
                     class="transform-card-img" />
            </div>
        </div>

        <!-- Single Clean Primary Action Button -->
        <div class="hero-cta-row">
            <a href="#copilot" class="btn btn-primary hero-btn-action">
                See in action <i class="bi-arrow-down-circle-fill"></i>
            </a>
        </div>
    </div>
</div>
