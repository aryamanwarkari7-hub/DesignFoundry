<!-- SECTION 02: THE SOLUTION (HEADING + PIPELINE + TIME-GAP ROW) -->
<section class="answers-section" id="answers" aria-label="Why Choose DesignFoundry">
    <div class="wrap ans-center-container">

        <!-- 1. UPDATED HEADING & SUBTITLE -->
        <div class="ans-head-block">
            <span class="eyebrow mono">THE SOLUTION</span>

            <h2 class="ans-title-headline">
                Move from proposal to manufacturing
                <span class="ans-accent-text">at 10X speed.</span>
            </h2>

            <p class="ans-intro-text">
                Generate manufacturing-ready documentation from requirements, without opening CAD.
            </p>
        </div>

        <!-- UNIFIED INTERACTIVE TRANSFORMATION STAGE -->
        <div class="ans-unified-stage" id="ansStage" data-mode="conventional">

            <!-- 1. Upper Mode Switcher Pills (with Tapping Hand Cue on DesignFoundry) -->
            <div class="ans-mode-tabs" role="tablist" aria-label="Design Workflow Comparison">
                <button type="button" class="ans-mode-tab is-active" id="ansTabConventional" role="tab" aria-selected="true">
                    Conventional
                </button>
                <button type="button" class="ans-mode-tab ans-tab-df" id="ansTabDesignFoundry" role="tab" aria-selected="false">
                    <span>DesignFoundry</span>
                    <span class="core-tap-cue" aria-hidden="true">
                        <span class="tap-ripple r1"></span>
                        <span class="tap-ripple r2"></span>
                        <svg class="tap-hand-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.5 3.5a1.5 1.5 0 0 1 3 0v6.75a1.5 1.5 0 0 1 3 .25v.5a1.5 1.5 0 0 1 3 .25v.75a1.5 1.5 0 0 1 2.75 1v3.75a5.5 5.5 0 0 1-5.5 5.5h-2.5a5.5 5.5 0 0 1-4.35-2.15l-3.2-4.15a1.5 1.5 0 0 1 2.22-1.98L9.5 15.25V3.5Z" class="tap-hand-path" />
                            <path d="M12.5 10.25v3m3-2.25v2.25m3-1.25v1.75" class="tap-hand-creases" />
                        </svg>
                    </span>
                </button>
            </div>

            <!-- 2. Workflow Process Visual (Crossfades between Conventional 5-step & DesignFoundry DF) -->
            <div class="ans-stage-visual">
                <!-- State A: Conventional 5-Step Process -->
                <div class="ans-view ans-view-conv" aria-hidden="false">
                    <div class="conv-step">
                        <i class="bi bi-pencil-square"></i>
                        <span>Sketch</span>
                    </div>
                    <i class="bi bi-arrow-right conv-arrow" aria-hidden="true"></i>
                    <div class="conv-step">
                        <i class="bi bi-calculator"></i>
                        <span>Calculations</span>
                    </div>
                    <i class="bi bi-arrow-right conv-arrow" aria-hidden="true"></i>
                    <div class="conv-step">
                        <i class="bi bi-box"></i>
                        <span>3D model</span>
                    </div>
                    <i class="bi bi-arrow-right conv-arrow" aria-hidden="true"></i>
                    <div class="conv-step">
                        <i class="bi bi-compass"></i>
                        <span>2D drawings</span>
                    </div>
                    <i class="bi bi-arrow-right conv-arrow" aria-hidden="true"></i>
                    <div class="conv-step">
                        <i class="bi bi-table"></i>
                        <span>BOM</span>
                    </div>
                </div>

                <!-- State B: DesignFoundry Automated Flow -->
                <div class="ans-view ans-view-df" aria-hidden="true">
                    <div class="df-cluster">
                        <div class="df-badge">DF</div>
                        <i class="bi bi-arrow-right df-arrow" aria-hidden="true"></i>
                        <div class="df-mini-steps">
                            <div class="df-mini-item">
                                <i class="bi bi-calculator"></i>
                                <span>Calc.</span>
                            </div>
                            <div class="df-mini-item">
                                <i class="bi bi-box"></i>
                                <span>3D</span>
                            </div>
                            <div class="df-mini-item">
                                <i class="bi bi-compass"></i>
                                <span>2D</span>
                            </div>
                            <div class="df-mini-item">
                                <i class="bi bi-table"></i>
                                <span>BOM</span>
                            </div>
                        </div>
                    </div>

                    <!-- Full Connected Arrow Between Left Card & Right Card -->
                    <div class="df-connector" aria-hidden="true">
                        <svg class="df-connector-svg" viewBox="0 0 120 24" preserveAspectRatio="none">
                            <line x1="0" y1="12" x2="110" y2="12" class="df-line-bg" />
                            <line x1="0" y1="12" x2="110" y2="12" class="df-line-pulse" />
                            <polyline points="102,6 112,12 102,18" class="df-arrow-head" />
                        </svg>
                    </div>

                    <div class="df-ready-box">
                        <i class="bi bi-check-circle"></i>
                        <span>Ready for manufacturing</span>
                    </div>
                </div>
            </div>

            <!-- 3. Animated Time Progress Bar & Labels -->
            <div class="ans-progress-block">
                <div class="ans-progress-track" aria-hidden="true">
                    <div class="ans-progress-fill"></div>
                </div>
                <div class="ans-progress-labels">
                    <div class="ans-time-left">
                        <span class="time-conv">Several days</span>
                        <span class="time-df">A few minutes</span>
                    </div>
                    <div class="ans-time-right">
                        <span class="speed-df">10X speed</span>
                    </div>
                </div>
            </div>

            <!-- 4. Bottom Full-Width Toggle Action -->
            <div class="ans-stage-footer">
                <button type="button" class="ans-stage-action" id="ansStageActionBtn">
                    <span class="action-conv">Experience the transformation <i class="bi bi-arrow-right"></i></span>
                    <span class="action-df">See conventional process <i class="bi bi-arrow-counterclockwise"></i></span>
                </button>
            </div>

        </div>

        
        <!-- CTA: Discuss your design flow -->
        <div class="ans-cta-block" style="display: flex; justify-content: center; margin-top: 34px;">
            <a href="@(Configuration["BookingSettings:MicrosoftBookingsUrl"] ?? "/contact")" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>

    </section>