<!-- SECTION 02: THE SOLUTION (HEADING + PIPELINE + TIME-GAP ROW) -->
<section class="answers-section" id="answers" aria-label="Why Choose DesignFoundry">
    <div class="wrap ans-center-container">

        <!-- 1. UPDATED HEADING & SUBTITLE -->
        <div class="ans-head-block">
            <span class="eyebrow mono">THE SOLUTION</span>

            <h2 class="ans-title-headline">
                Move from proposal to manufacturing
                <span class="ans-accent-text">at 10X speed.</span>
            </h2>

            <p class="ans-intro-text">
                Generate manufacturing-ready documentation from requirements, without opening CAD.
            </p>
        </div>

        <!-- UNIFIED STAGE -->
        <div class="ans-unified-stage">

            <!-- 2. OLD PART 1: PILL-ENCLOSED PIPELINE FLOW -->
            <div class="ans-band ans-band-pipeline">
                @* <div class="ans-band-header mono">
                    <span class="ans-tag">01 / ZERO CAD</span>
                    <span class="ans-badge-pill"><span class="badge-pulse-dot"></span> 0 CAD SEATS REQUIRED</span>
                </div> *@

                <div class="ans-flow-track">
                    <!-- Pill 1: Requirements (Heading Only + Pills) -->
                    <div class="flow-pill-box">
                        <div class="flow-pill-top">
                            <div class="flow-icon-ring">
                                <i class="bi bi-sliders"></i>
                            </div>
                            <span class="flow-node-title mono">REQUIREMENTS</span>
                        </div>
                        @* <div class="flow-mini-tags mono">
                            <span class="mini-tag">PARAMETERS</span>
                            <span class="mini-tag">CONSTRAINTS</span>
                        </div> *@
                    </div>

                    <!-- Animated SVG Connector 1 -->
                    <div class="flow-connector" aria-hidden="true">
                        <svg class="flow-svg" viewBox="0 0 80 24" preserveAspectRatio="none">
                            <line x1="0" y1="12" x2="72" y2="12" class="flow-line-bg" />
                            <line x1="0" y1="12" x2="72" y2="12" class="flow-line-pulse" />
                            <polyline points="64,6 74,12 64,18" class="flow-arrow-head" />
                        </svg>
                    </div>

                    <!-- Pill 2: Center Interactive Trigger Card (Switches Title: Conventional Process <-> DesignFoundry) -->
                    <button type="button" class="flow-pill-box core" id="ansCoreCard" aria-pressed="false">
                        <div class="flow-pill-top">
                            <div class="flow-icon-ring core">
                                <i class="bi bi-gear-wide-connected"></i>
                            </div>
                            <div class="core-title-swap mono">
                                <span class="core-title-old">CONVENTIONAL</span>
                                <span class="core-title-new">DESIGNFOUNDRY</span>
                            </div>
                        </div>
                        <span class="core-tap-cue" aria-hidden="true">
                            <span class="tap-ripple"></span>
                            <i class="bi bi-hand-index-thumb-fill"></i>
                        </span>
                    </button>

                    <!-- Animated SVG Connector 2 -->
                    <div class="flow-connector" aria-hidden="true">
                        <svg class="flow-svg" viewBox="0 0 80 24" preserveAspectRatio="none">
                            <line x1="0" y1="12" x2="72" y2="12" class="flow-line-bg" />
                            <line x1="0" y1="12" x2="72" y2="12" class="flow-line-pulse" />
                            <polyline points="64,6 74,12 64,18" class="flow-arrow-head" />
                        </svg>
                    </div>

                    <!-- Pill 3: Deliverables (3D / 2D / BOM Mini Square Cards + File Pills) -->
                    <div class="flow-pill-box out">
                        <div class="flow-pill-top">
                            <div class="flow-icon-ring out">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="out-square-row mono">
                                <span class="out-square-card">3D</span>
                                <span class="out-square-card">2D</span>
                                <span class="out-square-card">BOM</span>
                            </div>
                        </div>
                        @* <div class="flow-mini-tags mono">
                            <span class="mini-tag ok">.SLDASM</span>
                            <span class="mini-tag ok">.DWG</span>
                            <span class="mini-tag ok">.CSV</span>
                            <span class="mini-tag more">+ MORE</span>
                        </div> *@
                    </div>
                </div>
            </div>

            <!-- 3. SYNCHRONIZED SWITCHING TIME-REDUCTION BAR -->
            <!-- 3. INTERACTIVE TIME-REDUCTION BAR (DRIVEN BY CENTER CARD) -->
            <div class="ans-time-morph" id="ansTimeMorph" data-mode="conventional">
                <!-- Left/Center: Full-Width Shrinking Red -> Green Bar -->
                <div class="tm-track" aria-hidden="true">
                    <div class="tm-bar"></div>
                </div>

                <!-- Right: Active Time Pill -->
                <div class="tm-time-slot mono">
                    <span class="tm-time tm-old"><i class="bi bi-calendar-range"></i> Several Days</span>
                    <span class="tm-time tm-new"><i class="bi bi-stopwatch"></i> Few Minutes</span>
                </div>
            </div>

        </div>

        
        <!-- CTA: Discuss your design flow -->
        <div class="ans-cta-block" style="display: flex; justify-content: center; margin-top: 34px;">
            <a href="https://calendar.google.com/calendar/u/0/r?pli=1" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>

    </section>