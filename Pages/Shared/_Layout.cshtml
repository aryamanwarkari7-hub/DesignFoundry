<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@ViewData["Title"] - DesignFoundry</title>
    <meta name="description"
          content="DesignFoundry by Aryaman Technologies. Turn your legacy CAD data into reusable engineering intelligence: find, understand and adapt existing designs using natural language and automation.">
    <!-- BROWSER FAVICON -->
    <link rel="icon" type="image/x-icon" class"ico-icon" href="~/images/designfoundry_df_monogram.ico" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/images/designfoundry_df_monogram.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
            (function () {
                var savedTheme = localStorage.getItem('DesignFoundry_theme');
                if (savedTheme) {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                }
            })();
    </script>
</head>

<body>
    <!-- Interactive CAD Cloth Grid Canvas (Physical Fabric Physics) -->
    <canvas id="clothGridCanvas" aria-hidden="true"></canvas>

    <!-- Top Ambient Scroll Progress Bar -->
    <div class="scroll-progress-bar" id="scrollProgressBar" aria-hidden="true"></div>

    <!-- CAD RGBY 4-POINTER CROSSHAIR RETICLE (Cursor Follower) -->
    <div class="cad-cursor-hud" id="cadCursorHud" aria-hidden="true">
        <div class="cad-crosshair-center">
            <!-- 4-Way RGBY Gimbal Needles that Expand & Spin on Scroll -->
            <div class="cad-gimbal-spin" id="cadGimbalSpin">
                <!-- UP: Green (+Y Elevation) -->
                <div class="cad-pointer cad-pointer-up" title="+Y Axis">
                    <span class="pointer-axis mono">Y</span>
                    <span class="pointer-arrow green"></span>
                    <span class="pointer-line green"></span>
                </div>
                <!-- RIGHT: Red (+X Lateral) -->
                <div class="cad-pointer cad-pointer-right" title="+X Axis">
                    <span class="pointer-line red"></span>
                    <span class="pointer-arrow red"></span>
                    <span class="pointer-axis mono">X</span>
                </div>
                <!-- DOWN: Blue (+Z Feed/Depth) -->
                <div class="cad-pointer cad-pointer-down" title="+Z Axis">
                    <span class="pointer-line blue"></span>
                    <span class="pointer-arrow blue"></span>
                    <span class="pointer-axis mono">Z</span>
                </div>
                <!-- LEFT: Yellow (W Origin Datum) -->
                <div class="cad-pointer cad-pointer-left" title="Origin Datum">
                    <span class="pointer-axis mono">W</span>
                    <span class="pointer-arrow yellow"></span>
                    <span class="pointer-line yellow"></span>
                </div>
            </div>
            <!-- Center Precision Aperture Target Box -->
            <div class="cad-aperture">
                <span class="aperture-core"></span>
            </div>
        </div>
        <!-- CAD Live Coordinates Telemetry Badge -->
        <div class="cad-cursor-telemetry mono" id="cadCursorTelemetry">
            <span class="cad-tele-xy" id="cadTeleXY">X:000 Y:000</span>
            <span class="cad-tele-cad">CAD</span>
        </div>
    </div>



    <!-- STICKY HEADER -->
    <!-- 21st.dev FLOATING GLASS NAVBAR -->
    <header class="header-floating">
        <div class="nav-capsule">
            <!-- Brand & 3D Logo -->
            <a href="#top" class="logo" aria-label="DesignFoundry, a part of Aryaman Technologies">
                <img src="~/images/designfoundry_df_monogram.svg" alt="DesignFoundry" class="app-logo light-logo"
                     width="36" height="36" />
                <img src="~/images/designfoundry_df_monogram.svg" alt="DesignFoundry" class="app-logo dark-logo"
                     width="36" height="36" />
                <div class="logo-text">
                    <b>Design<strong>foundry</strong></b>
                    <span class="logo-sub ">A PART OF ARYAMAN TECHNOLOGIES</span>
                </div>
            </a>

            <!-- Navigation Links (Center Capsule) -->
            <nav class="nav-links" aria-label="Primary Navigation">
                <ul>
                    <li><a href="/#top">Home</a></li>
                    <li><a href="/#answers">Why Us</a></li>
                    <li><a href="/#why">Impact</a></li>
                    <li><a href="/#copilot">Workflow</a></li>
                    <li><a href="/#foundation">Built on Aryaman</a></li>
                    <li><a href="/#faq">FAQ</a></li>
                    <li><a href="/#contact">Contact Us</a></li>
                </ul>
            </nav>

            <!-- CTA Action (Glass Float Button, CAD Cursor Toggle & Sun-Moon Theme Toggle) -->
            <div class="nav-actions">
                <button type="button" class="btn-cad-toggle is-active" id="btnToggleCadCursor"
                        title="Toggle CAD Crosshair Cursor Reticle" aria-label="Toggle CAD Crosshair Cursor Reticle"
                        aria-pressed="true">
                    <i class="bi bi-crosshair2"></i>
                    <span class="toggle-text mono">CAD RETICLE</span>
                    <span class="toggle-status mono">ON</span>
                </button>

                <!-- 21st.dev dhxwhy Sun-Moon Animated Theme Toggle -->
                <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle dark/light theme"
                        title="Toggle dark/light theme">
                    <span class="theme-toggle-icon">
                        <!-- Sun Icon -->
                        <svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
                            <line x1="12" y1="1.5" x2="12" y2="3.5"></line>
                            <line x1="12" y1="20.5" x2="12" y2="22.5"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1.5" y1="12" x2="3.5" y2="12"></line>
                            <line x1="20.5" y1="12" x2="22.5" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                        <!-- Moon Icon -->
                        <svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor"></path>
                        </svg>
                    </span>
                </button>

                @* <a href="#contact" class="btn btn-primary">Book Technical Demo</a> *@
            </div>
        </div>
    </header>

    <!-- MAIN BODY CONTENT -->
    <main id="top">
        @RenderBody()
    </main>

    <!-- PRODUCT DETAIL MODAL: REFINED ENGINEERING INTELLIGENCE DOSSIER -->
    <!-- PILL-DRIVEN SCANNABLE PRODUCT MODAL -->
    <dialog id="pd" aria-labelledby="pdTitle">
        <!-- Header -->
        <div class="pd-head">
            <div class="pd-head-left">
                <span class="mono pd-cat-badge" id="pdCat"></span>
                <h3 id="pdTitle"></h3>
            </div>
            <div class="pd-head-right">
                <span class="pd-platform-pill mono"><i class="bi bi-cpu"></i> SOLIDWORKS &bull; INVENTOR &bull;
                    CREO</span>
                    <button type="button" class="pd-x" id="pdClose" aria-label="Close dialog">&times;</button>
                </div>
            </div>

            <!-- Body -->
            <div class="pd-body">
                <!-- 1. Top Impact Stat Strip -->
                <div class="pd-stat-strip mono">
                    <div class="pd-stat-pill">
                        <span class="val accent">&minus;85%</span>
                        <span class="lbl">Drafting Time</span>
                    </div>
                    <div class="pd-stat-pill">
                        <span class="val green">&lt; 2 MIN</span>
                        <span class="lbl">Full CAD Model</span>
                    </div>
                    <div class="pd-stat-pill">
                        <span class="val">100%</span>
                        <span class="lbl">Parametric Mates</span>
                    </div>
                    <div class="pd-stat-pill">
                        <span class="val accent">REAL-TIME</span>
                        <span class="lbl">ERP BOM Sync</span>
                    </div>
                </div>

                <!-- 2. Bento 2-Col Grid (Pill-Heavy & Scannable) -->
                <div class="pd-grid-2col">
                    <!-- Left: The Equipment Identity -->
                    <div class="pd-col-left">
                        <div class="pd-card-block">
                            <span class="pd-section-label mono"><i class="bi bi-info-circle"></i> 01 : WHAT IT IS</span>
                            <p class="pd-brief-lead" id="pdBrief"></p>
                        </div>

                        <div class="pd-card-block">
                            <span class="pd-section-label mono"><i class="bi bi-grid-3x3-gap"></i> 02 : TYPICAL
                                APPLICATIONS</span>
                                <div class="pd-pill-cloud" id="pdAppsPills">
                                    <!-- Injected by JS as .pd-chip pills -->
                                </div>
                            </div>

                            <div class="pd-card-block">
                                <span class="pd-section-label mono"><i class="bi bi-shield-check"></i> 03 : GOVERNING
                                    CODES</span>
                                    <div class="pd-pill-cloud" id="pdStandardsPills">
                                        <!-- Injected by JS as .pd-chip pills -->
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Copilot Automation (Pills & Checkmark Cards) -->
                            <div class="pd-col-right">
                                <div class="pd-solution-card">
                                    <span class="pd-solution-tag mono">
                                        <i class="bi bi-lightning-charge-fill"></i> HOW DESIGNFOUNDRY AUTOMATES THIS
                                    </span>

                                    <!-- 3 Scannable Action Pills -->
                                    <div class="pd-automation-pills">
                                        <div class="pd-auto-item">
                                            <i class="bi bi-check-circle-fill ok"></i>
                                            <div>
                                                <strong>Zero Manual Spreadsheets</strong>
                                                <span>Solves aerodynamics, heat duties, and cut-off curves in seconds.</span>
                                            </div>
                                        </div>
                                        <div class="pd-auto-item">
                                            <i class="bi bi-check-circle-fill ok"></i>
                                            <div>
                                                <strong>Dynamic 3D CAD Assembly</strong>
                                                <span>Generates full component assembly with native kinematic mates.</span>
                                            </div>
                                        </div>
                                        <div class="pd-auto-item">
                                            <i class="bi bi-check-circle-fill ok"></i>
                                            <div>
                                                <strong>Manufacturing Deliverables</strong>
                                                <span>Auto-generates 2D DWG fabrication drawings, flat unrolls, and BOM.</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Speed Comparison Badges -->
                                    <div class="pd-speed-row mono">
                                        <div class="pd-speed-pill legacy">
                                            <span class="badge">&times; LEGACY</span>
                                            <span>3&ndash;5 Days Manual CAD</span>
                                        </div>
                                        <div class="pd-speed-pill ai">
                                            <span class="badge">&check; COPILOT</span>
                                            <span>&lt; 2 Mins Automated</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

        <!-- Footer -->
        <div class="pd-foot">
            <div class="pd-foot-left">
                <a class="btn btn-primary" href="/#contact" id="pdTalk">
                    <i class="bi bi-envelope-arrow-up"></i> Discuss this Copilot
                </a>
                <button type="button" class="pd-copy-btn" id="pdCopySpecs">
                    <i class="bi bi-clipboard"></i> Copy Specs
                </button>
                <a class="pd-pdf-link mono" id="pdPdf" href="#" target="_blank" rel="noopener">
                    <i class="bi bi-file-earmark-pdf"></i> Technical Leaflet (PDF)
                </a>
            </div>
            <div class="pd-foot-right mono">
                <span class="pulse-dot"></span> PROVEN ARYAMAN ENGINE &bull; 19+ YRS
            </div>
        </div>
    </dialog>

                <!-- SIMPLISTIC BLUEPRINT FOOTER (Contained Section Capsule) -->
                <footer class="site-footer">
                    <div class="foot">
                        <div class="foot-brand">
                            <div class="foot-logo mono">
                                <span class="foot-dot"></span> DesignFoundry &middot; <span class="foot-sub">PARAMETRIC CAD
                                COPILOT</span>
                            </div>
                            <p class="foot-legal">
                                &copy; 2026 <a href="https://www.aryamantechnologies.com" target="_blank" rel="noopener noreferrer"
                                               class="foot-link">Aryaman Technologies Private Limited</a> &middot; Karvenagar, Pune &ndash;
                                411052, India<br>
                                <span class="mono">CIN: U74999PN2018PTC175883</span>
                            </p>
                        </div>

                        <!-- Sleek Glass CAD Title Block -->
                        <div class="foot-titleblock mono" aria-label="Engineering Drawing Title Block">
                            <div class="tb-cell"><span class="tb-lbl">DRAWN BY</span> <strong class="tb-val">ARYAMAN</strong>
                            </div>
                            <div class="tb-cell"><span class="tb-lbl">STANDARDS</span> <strong class="tb-val">ISO / ASME</strong>
                            </div>
                            <div class="tb-cell"><span class="tb-lbl">LOCATION</span> <strong class="tb-val">PUNE, IN</strong></div>
                            <div class="tb-cell"><span class="tb-lbl">DOMAIN</span> <strong
                                class="tb-val">DesignFoundry.COM</strong></div>
                            </div>
                        </div>
                    </footer>
<!-- GLOBAL SCRIPTS -->
<!-- Lenis Smooth Scrolling Engine (3.5KB) -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/cad-viewer.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
