@* 
    DesignFoundry - Customers Section
    Connected Carousel inspired by 21st.dev/@arunachalam/components/connected-carousel
*@
<section class="customers-section" id="customers" aria-label="Customer Success Stories">
    <!-- Header Block -->
    <div class="cust-head-block">
        <span class="cust-badge">CUSTOMER STORIES</span>
        <h2 class="cust-title">
            See who uses it.<br>
            <span class="cust-accent-text">Engineers delivering CAD in minutes.</span>
        </h2>
        <p class="cust-desc">
            Hear how machinery OEMs, heavy equipment fabricators, and engineering leaders eliminate drafting queues with
            DesignFoundry.
        </p>
    </div>

    <!-- Connected Carousel Stage -->
    <div class="cc-stage-wrapper">
        <!-- Mobile Carousel Controls (Above Cards) -->
        <div class="cc-mobile-nav">
            <button type="button" class="cc-nav-btn" id="ccPrevBtn" aria-label="Previous customer story">
                <i class="bi bi-arrow-left"></i>
            </button>
            <span class="cc-mobile-counter mono" id="ccCounter">01 / 05</span>
            <button type="button" class="cc-nav-btn" id="ccNextBtn" aria-label="Next customer story">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>

        <!-- Connecting Horizontal Bridge Line -->
        <div class="cc-bridge-line" aria-hidden="true"></div>

        <!-- Carousel Track -->
        <div class="cc-track" id="ccTrack">
            <!-- 5 Customer Story Cards -->
            <article class="cc-card" data-index="0" role="group" aria-label="Slide 1 of 5">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">98% Faster CAD Delivery</div>
                        <blockquote class="cc-quote">
                            &ldquo;Standard conveyor configurations that used to take our drafting team 3 to 4 days are
                            now generated, verified, and released to the shop floor in under 180 seconds.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Rajesh Kulkarni</span>
                            <span class="cc-author-role">VP of Engineering at Precision Conveyors Ltd.</span>
                        </div>
                    </div>
                    <div class="cc-card-visual">
                        <img src="https://cdn.21st.dev/assets/mirror/c6/c6c51783628e317008b03004640a273251c41c6373a6fc63738dc2d56df83965.jpg"
                             alt="Rajesh Kulkarni at engineering workstation" class="cc-photo" loading="lazy" />
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="1" role="group" aria-label="Slide 2 of 5">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">450+ Assemblies Delivered</div>
                        <blockquote class="cc-quote">
                            &ldquo;Automating parametric boom, bucket, and chassis variants eliminated our drafting
                            backlog and gave our senior engineering leads their focus back.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Julian Chen</span>
                            <span class="cc-author-role">Chief Mechanical Engineer at Titan Heavy Equipment</span>
                        </div>
                    </div>
                    <div class="cc-card-visual">
                        <img src="https://cdn.21st.dev/assets/mirror/b7/b72b0f4f4e2184862eb73dfd44a2f950ce712284c82dc52099d0c0df634e8306.jpg"
                             alt="Julian Chen in design office" class="cc-photo" loading="lazy" />
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="2" role="group" aria-label="Slide 3 of 5">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">100% ASME Code-Compliant</div>
                        <blockquote class="cc-quote">
                            &ldquo;Calculations, nozzle orientations, and fabrication-ready 2D drawings are produced
                            directly from customer pressure specs with zero manual drafting errors.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Dr. Amara Okafor</span>
                            <span class="cc-author-role">Lead Pressure Vessel Engineer at Apex Process Vessels</span>
                        </div>
                    </div>
                    <div class="cc-card-visual">
                        <img src="https://cdn.21st.dev/assets/mirror/92/926db583face6f84ed326570a2d38c0e7b1338449f444de0e6d0b920b40e552f.jpg"
                             alt="Dr. Amara Okafor inspecting plant models" class="cc-photo" loading="lazy" />
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="3" role="group" aria-label="Slide 4 of 5">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">3.5 Weeks Saved Per Project</div>
                        <blockquote class="cc-quote">
                            &ldquo;Our sales engineers now generate complete 3D models and manufacturing BOMs in front
                            of clients during proposal meetings without waiting in drafting queues.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Maya Lindqvist</span>
                            <span class="cc-author-role">Director of Automation Design at MotionTech Robotics</span>
                        </div>
                    </div>
                    <div class="cc-card-visual">
                        <img src="https://cdn.21st.dev/assets/mirror/56/56efabba2e6ba75d83c0d8a93e27e695630b6ef6df1f0f92542e6f7d88e585a5.jpg"
                             alt="Maya Lindqvist reviewing robotic CAD models" class="cc-photo" loading="lazy" />
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="4" role="group" aria-label="Slide 5 of 5">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">0 Shop-Floor Rework Delays</div>
                        <blockquote class="cc-quote">
                            &ldquo;Direct parameter-to-drawing automation completely eliminated manual transcription
                            errors and drawing rejections between design and manufacturing.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Siddharth Rao</span>
                            <span class="cc-author-role">Head of Plant Operations at FlowDynamics OEM</span>
                        </div>
                    </div>
                    <div class="cc-card-visual">
                        <img src="https://cdn.21st.dev/assets/mirror/bf/bf5e190044b602e47fe1fd6933360d80a1503e25b1f86bb28222d49e797224f3.jpg"
                             alt="Siddharth Rao at industrial valve facility" class="cc-photo" loading="lazy" />
                    </div>
                </div>
            </article>
        </div>

        <!-- Progress Indicators & Navigation -->
        <div class="cc-indicators" id="ccIndicators" aria-label="Carousel Progress">
            <button class="cc-dot active" data-index="0" aria-label="Go to story 1"><span
                class="cc-dot-fill"></span></button>
                <button class="cc-dot" data-index="1" aria-label="Go to story 2"><span class="cc-dot-fill"></span></button>
                <button class="cc-dot" data-index="2" aria-label="Go to story 3"><span class="cc-dot-fill"></span></button>
                <button class="cc-dot" data-index="3" aria-label="Go to story 4"><span class="cc-dot-fill"></span></button>
                <button class="cc-dot" data-index="4" aria-label="Go to story 5"><span class="cc-dot-fill"></span></button>
            </div>
        </div>

        <!-- CTA: Discuss your design flow -->
        <div class="cust-cta-block" style="display: flex; justify-content: center; margin-top: 32px;">
            <a href="@(Configuration["BookingSettings:MicrosoftBookingsUrl"] ?? "/contact")" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>
    </section>