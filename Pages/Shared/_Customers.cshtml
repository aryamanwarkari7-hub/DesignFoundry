@* 
    DesignFoundry - Customers Section
    Connected Carousel inspired by 21st.dev/@arunachalam/components/connected-carousel
*@
<section class="customers-section" id="customers" aria-label="Customer Success Stories">
    <!-- Header Block -->
    <div class="cust-head-block">
        <span class="cust-badge">CUSTOMER STORIES</span>
        <h2 class="cust-title">
            See who uses it.<br>
            <span class="cust-accent-text">Engineers delivering CAD in minutes.</span>
        </h2>
        <p class="cust-desc">
            Hear how machinery OEMs, heavy equipment fabricators, and engineering leaders eliminate drafting queues with
            DesignFoundry.
        </p>
    </div>

    <!-- Connected Carousel Stage -->
    <div class="cc-stage-wrapper">
        <!-- Mobile Carousel Controls (Above Cards) -->
        <div class="cc-mobile-nav">
            <button type="button" class="cc-nav-btn" id="ccPrevBtn" aria-label="Previous customer story">
                <i class="bi bi-arrow-left"></i>
            </button>
            <span class="cc-mobile-counter mono" id="ccCounter">01 / 03</span>
            <button type="button" class="cc-nav-btn" id="ccNextBtn" aria-label="Next customer story">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>

        <!-- Connecting Horizontal Bridge Line -->
        <div class="cc-bridge-line" aria-hidden="true"></div>

        <!-- Carousel Track -->
        <div class="cc-track" id="ccTrack">
            <!-- 3 Customer Story Cards -->
            <article class="cc-card" data-index="0" role="group" aria-label="Slide 1 of 3">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">100% ASME Code-Compliant</div>
                        <blockquote class="cc-quote">
                            &ldquo;Calculations, nozzle orientations, and fabrication-ready 2D drawings for pressure
                            vessels and air receiver tanks are generated directly from customer specs with zero manual
                            drafting errors.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Anand Thipse</span>
                            <span class="cc-author-role">Founder, TechnoMek Engineering Solutions &bull; Pune</span>
                        </div>
                    </div>
                    <div class="cc-card-visual cc-logo-panel">
                        <div class="cc-logo-mark" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="14" y="10" width="36" height="44" rx="18" stroke="#f26a0a" stroke-width="2.5" />
                                <line x1="14" y1="24" x2="50" y2="24" stroke="currentColor" stroke-width="2" opacity="0.6" />
                                <line x1="14" y1="40" x2="50" y2="40" stroke="currentColor" stroke-width="2" opacity="0.6" />
                                <path d="M50 28H56V36H50" stroke="#f26a0a" stroke-width="2.2" stroke-linecap="round" />
                            </svg>
                        </div>
                        <strong class="cc-company-name">TechnoMek Engineering</strong>
                        <span class="cc-company-tag mono">PROCESS EQUIPMENT &bull; TECHNOMEKES.COM</span>
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="1" role="group" aria-label="Slide 2 of 3">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">98% Faster CAD Delivery</div>
                        <blockquote class="cc-quote">
                            &ldquo;Standard belt conveyor and silo configurations that used to take our drafting team 3
                            to 4 days are now generated, verified, and released to the shop floor in under 2 minutes.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Engineering Lead</span>
                            <span class="cc-author-role">Rollcon Technofab &bull; Bulk Material Handling</span>
                        </div>
                    </div>
                    <div class="cc-card-visual cc-logo-panel">
                        <div class="cc-logo-mark" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="8" y="24" width="48" height="14" rx="7" stroke="#f26a0a" stroke-width="2.5" />
                                <circle cx="16" cy="31" r="3.5" fill="#f26a0a" />
                                <circle cx="32" cy="31" r="3.5" fill="currentColor" opacity="0.7" />
                                <circle cx="48" cy="31" r="3.5" fill="#f26a0a" />
                                <path d="M18 38L14 50M46 38L50 50" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity="0.6" />
                            </svg>
                        </div>
                        <strong class="cc-company-name">Rollcon Technofab</strong>
                        <span class="cc-company-tag mono">BULK HANDLING &bull; ROLLCON.NET</span>
                    </div>
                </div>
            </article>

            <article class="cc-card" data-index="2" role="group" aria-label="Slide 3 of 3">
                <div class="cc-card-inner">
                    <div class="cc-card-content">
                        <div class="cc-metric">3.5 Weeks Saved Per Order</div>
                        <blockquote class="cc-quote">
                            &ldquo;Our thermal engineers generate complete 3D shell-and-tube assemblies, baffle layouts,
                            and manufacturing BOMs during client proposal meetings without waiting in drafting queues.&rdquo;
                        </blockquote>
                        <div class="cc-author-info">
                            <span class="cc-author-pill">Chief Thermal Engineer</span>
                            <span class="cc-author-role">Enersys Thermal Technologies &bull; Heat Exchangers</span>
                        </div>
                    </div>
                    <div class="cc-card-visual cc-logo-panel">
                        <div class="cc-logo-mark" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="10" y="18" width="44" height="28" rx="6" stroke="#f26a0a" stroke-width="2.5" />
                                <line x1="16" y1="26" x2="48" y2="26" stroke="currentColor" stroke-width="2" opacity="0.7" />
                                <line x1="16" y1="32" x2="48" y2="32" stroke="#f26a0a" stroke-width="2" />
                                <line x1="16" y1="38" x2="48" y2="38" stroke="currentColor" stroke-width="2" opacity="0.7" />
                                <path d="M22 12V18M42 46V52" stroke="#f26a0a" stroke-width="2.2" stroke-linecap="round" />
                            </svg>
                        </div>
                        <strong class="cc-company-name">Enersys Thermal</strong>
                        <span class="cc-company-tag mono">HEAT EXCHANGERS &bull; ENERSYSTHERMAL.COM</span>
                    </div>
                </div>
            </article>
        </div>

        <!-- Progress Indicators & Navigation -->
        <div class="cc-indicators" id="ccIndicators" aria-label="Carousel Progress">
            <button class="cc-dot active" data-index="0" aria-label="Go to story 1"><span class="cc-dot-fill"></span></button>
            <button class="cc-dot" data-index="1" aria-label="Go to story 2"><span class="cc-dot-fill"></span></button>
            <button class="cc-dot" data-index="2" aria-label="Go to story 3"><span class="cc-dot-fill"></span></button>
        </div>
        </div>

        <!-- CTA: Discuss your design flow -->
        <div class="cust-cta-block" style="display: flex; justify-content: center; margin-top: 32px;">
            <a href="@(Configuration["BookingSettings:MicrosoftBookingsUrl"] ?? "/contact")" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>
    </section>