            <span class="dim-line"></span>
            <span class="dim-tick">&dashv;</span>
        </div>
        <div class="flank-data-block">
            <div class="data-row"><span>GD&T:</span> &target; &empty;0.03 | A | B</div>
            <div class="data-row"><span>SURFACE:</span> Ra 0.8 &mu;m</div>
            <div class="data-row"><span>TOL:</span> ISO 2768-mK</div>
        </div>
    </aside>
    <!-- RIGHT FLANK: PARAMETRIC CAD FEATURE TREE -->
    <aside class="hero-cad-flank flank-right mono" aria-hidden="true">
