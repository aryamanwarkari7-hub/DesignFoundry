            <span class="flank-badge-green">&check; KERNEL ACTIVE</span>
            <span class="flank-crosshair">&target;</span>
        </div>
        <div class="flank-tree-block">
            <div class="tree-title"><i class="bi bi-diagram-3"></i> Actuator_Assy.sldasm</div>
