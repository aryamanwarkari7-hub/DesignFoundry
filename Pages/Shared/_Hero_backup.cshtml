            <div class="tree-branch">&boxur; Sizing: NEMA 34 (7.2 Nm)</div>
        </div>
        <div class="flank-data-block">
            <div class="data-row status-ok"><span>SYNC:</span> ERP-BOM LINKED</div>
            <div class="data-row"><span>MAT:</span> AL 6061-T6</div>
        </div>
    </aside> *@

