<!-- FAQS: BENTO CARDS MATRIX WITH LIVE SEARCH & CATEGORY FILTERING -->
<section class="faq" id="faq">
    <div class="wrap">
        <div class="sec-head center">
            <p class="eyebrow mono" style="justify-content: center; display: flex;">FAQs</p>
            <h2>Questions engineers ask first</h2>
            <p>Direct answers on CAD platform compatibility, data integrity, and engineering logic.</p>
        </div>

        <!-- TOP BAR: CENTERED SEARCH INPUT -->
        <div class="faq-toolbar">
            <div class="faq-search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="faqSearchInput" class="faq-search-input"
                       placeholder="Search questions (e.g. SolidWorks, NX, FEA, NLP, PDM)..." autocomplete="off" />
            </div>
        </div>

        <!-- TECHNICAL CATEGORY FILTER PILLS -->
        <div class="faq-filter-bar" id="faqFilterBar">
            <button type="button" class="faq-filter-pill active" data-cat="all">
                <span class="pill-dot"></span> All Questions <span class="pill-count">6</span>
            </button>
            <button type="button" class="faq-filter-pill" data-cat="Compatibility">
                CAD Platforms
            </button>
            <button type="button" class="faq-filter-pill" data-cat="Extraction">
                Data & Extraction
            </button>
            <button type="button" class="faq-filter-pill" data-cat="NLP Logic">
                NLP & Automation
            </button>
            <button type="button" class="faq-filter-pill" data-cat="Model Safety">
                Model Safety
            </button>
            <button type="button" class="faq-filter-pill" data-cat="Simulation">
                FEA / CFD
            </button>
        </div>

        <!-- PERMANENT BENTO CARDS MATRIX -->
        <div class="faq-bento-container">
            <div class="faq-cards-matrix" id="faqCardsMatrix">
                <!-- Dynamically populated via site.js -->
            </div>
        </div>

    </div>
</section>