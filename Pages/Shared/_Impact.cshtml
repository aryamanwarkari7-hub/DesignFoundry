<!-- SECTION 03: BENEFITS ("MORE ENGINEERING. LESS ADMINISTRATION.") -->
<section class="impact-section" id="benefits" aria-label="Engineering Benefits">
    <div class="wrap impact-center-container">

        <!-- Centered Header Block -->
        <div class="impact-head-block">
            <span class="eyebrow mono">BENEFITS</span>
            <h2 class="impact-title">
                More Engineering.<br>
                <span class="impact-accent">Less administration.</span>
            </h2>
            <p class="impact-subtitle">
                Free your engineering team from repetitive drafting so they can focus on innovation and complex design challenges.
            </p>
        </div>

        <!-- Clean 3-Column Hairline-Divided Architectural Strip (No Card Fatigue) -->
        <div class="impact-strip">

            <!-- Pillar 1: Increase Design Capacity -->
            <div class="impact-col">
                <div class="impact-icon-box" aria-hidden="true">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="6" y="13" width="14" height="16" rx="2.5" stroke="#f26a0a" stroke-width="1.8" />
                        <rect x="11" y="9" width="14" height="16" rx="2.5" stroke="#f26a0a" stroke-width="1.8" fill="var(--impact-svg-bg, #ffffff)" />
                        <rect x="16" y="5" width="14" height="16" rx="2.5" stroke="#f26a0a" stroke-width="1.8" fill="var(--impact-svg-bg, #ffffff)" />
                        <path d="M23 28L30 21M30 21H25M30 21V26" stroke="#f26a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h3 class="impact-col-title">Increase design capacity</h3>
                <p class="impact-col-desc">
                    Deliver more designs with your existing engineering team.
                </p>
            </div>

            <!-- Pillar 2: Standardize Design Quality -->
            <div class="impact-col">
                <div class="impact-icon-box" aria-hidden="true">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="7" y="5" width="18" height="24" rx="2.5" stroke="#f26a0a" stroke-width="1.8" />
                        <circle cx="16" cy="13" r="4" stroke="#f26a0a" stroke-width="1.8" />
                        <circle cx="16" cy="13" r="1.3" fill="#f26a0a" />
                        <path d="M11 21H17M11 24.5H15" stroke="#f26a0a" stroke-width="1.8" stroke-linecap="round" />
                        <circle cx="25" cy="25" r="6" fill="var(--impact-svg-bg, #ffffff)" stroke="#f26a0a" stroke-width="1.8" />
                        <path d="M22.5 25L24.2 26.7L27.8 23.1" stroke="#f26a0a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h3 class="impact-col-title">Standardize design quality</h3>
                <p class="impact-col-desc">
                    Reduce errors through consistent design rules and engineering standards.
                </p>
            </div>

            <!-- Pillar 3: Retain Engineering Expertise -->
            <div class="impact-col">
                <div class="impact-icon-box" aria-hidden="true">
                    <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 10C15 8 10 8 6 9.5V27.5C10 26 15 26 18 28C21 26 26 26 30 27.5V9.5C26 8 21 8 18 10Z" stroke="#f26a0a" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M18 10V28" stroke="#f26a0a" stroke-width="1.8" />
                        <path d="M9.5 14H14.5M9.5 18H14.5M9.5 22H13.5" stroke="#f26a0a" stroke-width="1.7" stroke-linecap="round" />
                        <circle cx="24" cy="18" r="4" stroke="#f26a0a" stroke-width="1.8" />
                        <circle cx="24" cy="18" r="1.4" fill="#f26a0a" />
                    </svg>
                </div>
                <h3 class="impact-col-title">Retain engineering expertise</h3>
                <p class="impact-col-desc">
                    Capture and reuse your organization&rsquo;s engineering knowledge.
                </p>
            </div>

        </div>

        <!-- CTA: Discuss your design flow -->
        <div class="impact-cta-block" style="display: flex; justify-content: center; margin-top: 38px;">
            <a href="@(Configuration["BookingSettings:MicrosoftBookingsUrl"] ?? "/contact")" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>

    </div>
</section>
