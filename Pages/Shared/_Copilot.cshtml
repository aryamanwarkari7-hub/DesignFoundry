<!-- ENGINEERING COPILOT (2-COLUMN 100VH WORKFLOW STUDIO) -->
<section class="copilot" id="copilot" aria-label="How the Copilot Works">
    <div class="wrap cp-grid-2col">
        <!-- LEFT COLUMN: ONLY HEADLINE & INTENT -->
        <div class="cp-left-copy">
            <div class="cp-title-group">
                <p class="eyebrow mono"><i class="bi bi-lightning-charge-fill"></i> HOW IT WORKS</p>
                <h2>See how<br><em>simple it is.</em></h2>
                <p class="cp-lead">
                    Enter your design requirements, generate the design, and get manufacturing-ready outputs.
                </p>
            </div>
        </div>

        @* ==========================================================
           ORIGINAL INTERACTIVE JS ASSEMBLY SIMULATOR (COMMENTED OUT ONLY - PRESERVED FOR RESTORE)
           ==========================================================
        <!-- RIGHT COLUMN: FULL ASSEMBLY SIMULATOR CONSOLE -->
        <div class="glass-card cp-simulator-chamber">
            <!-- Top Horizontal 5-Step Pipeline Rail -->
            <div class="cp-horizontal-pipeline mono" id="cpWorkflowRail">
                <button type="button" class="cp-pipe-step active" data-step="1">
                    <span class="step-num">01</span>
                    <span class="step-lbl">Scan Mates</span>
                </button>
                <button type="button" class="cp-pipe-step" data-step="2">
                    <span class="step-num">02</span>
                    <span class="step-lbl">Parametric Logic</span>
                </button>
                <button type="button" class="cp-pipe-step" data-step="3">
                    <span class="step-num">03</span>
                    <span class="step-lbl">Plain Specs</span>
                </button>
                <button type="button" class="cp-pipe-step" data-step="4">
                    <span class="step-num">04</span>
                    <span class="step-lbl">Verify FEA</span>
                </button>
                <button type="button" class="cp-pipe-step" data-step="5">
                    <span class="step-num">05</span>
                    <span class="step-lbl">Regenerate CAD</span>
                </button>
            </div>

            <!-- Console Header with Live Controls / Picker -->
            <div class="sim-header">
                <div class="sim-title mono">
                    <span class="pulse-dot"></span> LIVE ASSEMBLY SIMULATOR
                    <span class="sim-demo-badge mono" id="simDemoBadge">DRAG TO CONTROL</span>
                </div>
                <div class="sim-controls">
                    <label for="pnpSlider" class="sim-slider-label mono">
                        STROKE: <strong id="pnpStrokeVal" class="accent">450 MM</strong>
                    </label>
                    <input type="range" id="pnpSlider" min="300" max="680" value="450" step="10" class="sim-range">
                    <div class="sim-presets mono">
                        <button type="button" class="preset-btn" data-stroke="350">350</button>
                        <button type="button" class="preset-btn active" data-stroke="450">450</button>
                        <button type="button" class="preset-btn" data-stroke="600">600</button>
                    </div>
                </div>
            </div>

            <!-- Workflow Stepper HUD Feedback -->
            <div class="sim-workflow-hud mono" id="simWorkflowHud">
                <span class="hud-step-tag" id="hudStepTag">STEP 01</span>
                <span class="hud-desc" id="hudStepDesc">Scanning SolidWorks assembly tree (84 parts, 112 mates
                    mapped)</span>
                </div>

                                <!-- Dynamic Pick & Place SVG Canvas -->
                <div class="sim-canvas-viewport">
                    <svg id="cpSvgInteractive" viewBox="0 0 540 180" role="img"
                         aria-label="Interactive pick and place CAD machine">
                        
                        <!-- FEA & Stage Gradients -->
                        <defs>
                            <linearGradient id="feaStressGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#38ef7d" stop-opacity="0.9" />
                                <stop offset="60%" stop-color="#f26a0a" stop-opacity="0.95" />
                                <stop offset="100%" stop-color="#ff4757" stop-opacity="1" />
                            </linearGradient>
                        </defs>

                        <!-- Machine Base Bed -->
                        <rect id="svgBaseBed" class="svg-bed" x="40" y="160" width="370" height="10" rx="3" fill="#0d1f42"
                              stroke="rgba(140,180,240,0.3)" stroke-width="1.5" />
                        <!-- Left Fixed Post -->
                        <rect class="svg-post" x="60" y="65" width="14" height="95" rx="2" fill="#142a58"
                              stroke="rgba(140,180,240,0.4)" stroke-width="1" />
                        <!-- Right Mobile Post -->
                        <rect id="svgRightPost" class="svg-post" x="330" y="65" width="14" height="95" rx="2" fill="#142a58"
                              stroke="rgba(140,180,240,0.4)" stroke-width="1" />
                        <!-- Linear Guide Rail -->
                        <rect id="svgGuideRail" x="67" y="75" width="270" height="7" rx="2" fill="#f26a0a" />

                        <!-- Dimension Line & Text -->
                        <line id="svgDimLine" x1="74" y1="55" x2="337" y2="55" stroke="#f26a0a" stroke-width="1.5"
                              stroke-dasharray="4 3" />
                        <line x1="74" y1="49" x2="74" y2="61" stroke="#f26a0a" stroke-width="1.5" />
                        <line id="svgDimTickR" x1="337" y1="49" x2="337" y2="61" stroke="#f26a0a" stroke-width="1.5" />
                        <text id="svgDimText" x="205" y="47" font-size="11" font-family="monospace" fill="#ffffff"
                              text-anchor="middle" font-weight="bold">STROKE: 450 MM</text>

                        <!-- Workpiece & Target Zone -->
                        <rect x="90" y="138" width="20" height="22" rx="2" fill="#f26a0a" opacity="0.85" />
                        <rect id="svgTargetZone" x="298" y="138" width="20" height="22" rx="2" fill="none" stroke="#f26a0a"
                              stroke-width="1.5" stroke-dasharray="3 3" />
                    </svg>
                </div>
                

                <!-- Real-time Verification Telemetry Strip -->
                <div class="sim-telemetry mono">
                    <div class="telem-item">
                        <i class="bi bi-check-circle-fill ok"></i>
                        <span>MATES:</span> <strong>18/18 INTACT</strong>
                    </div>
                    <div class="telem-item">
                        <i class="bi bi-shield-check ok"></i>
                        <span>FEA:</span> <strong id="telemDeflect">0.038 MM</strong>
                    </div>
                    <div class="telem-item">
                        <i class="bi bi-cpu ok"></i>
                        <span>TORQUE:</span> <strong id="telemTorque">4.8 NM</strong>
                    </div>
                    <div class="telem-item">
                        <i class="bi bi-arrow-repeat ok"></i>
                        <span>BOM:</span> <strong>REAL-TIME</strong>
                    </div>
                </div>
            </div>
        ========================================================== *@

        <!-- RIGHT COLUMN: WORKFLOW VIDEO CONTAINER -->
        <div class="glass-card cp-video-chamber">
            <div class="cp-video-topbar">
                <div class="sim-title mono">
                    <span class="pulse-dot"></span> BELT CONVEYOR 
                    <span class="sim-demo-badge mono">HD VIDEO</span>
                </div>
                <button type="button" class="cp-fullscreen-btn mono" id="cpBtnFullscreen" aria-label="Expand video to fullscreen" title="Expand to fullscreen">
                    <i class="bi bi-arrows-fullscreen"></i>
                    <span>EXPAND FULLSCREEN</span>
                </button>
            </div>

            <!-- Native HTML5 CAD Workflow Video Player (Zero 3rd-party scripts, zero BotGuard errors) -->
            <div class="cp-video-frame">
                <video id="cpWorkflowVideo"
                       class="cp-video-player"
                       controls
                       playsinline
                       preload="metadata"
                       poster="/images/why_cad_assembly.png">
                    @* <source src="/videos/Belt%20Conveyor%20Design.mp4" type="video/mp4" /> *@
                    <source src="/videos/Earth-rotates.mp4" type="video/mp4" />
                    <p class="mono text-muted" style="padding:20px;text-align:center;">
                        Your browser does not support HTML5 video.
                    </p>
                </video>
            </div>

            <!-- Real-time Verification Telemetry Strip (Preserves CAD Console Status) -->
            @* <div class="sim-telemetry mono">
                <div class="telem-item">
                    <i class="bi bi-check-circle-fill ok"></i>
                    <span>INPUT:</span> <strong>PLAIN SPECS</strong>
                </div>
                <div class="telem-item">
                    <i class="bi bi-shield-check ok"></i>
                    <span>ENGINE:</span> <strong>AUTOMATED SOLVER</strong>
                </div>
                <div class="telem-item">
                    <i class="bi bi-cpu ok"></i>
                    <span>CAD:</span> <strong>3D &bull; 2D &bull; BOM</strong>
                </div>
                <div class="telem-item">
                    <i class="bi bi-box-seam ok"></i>
                    <span>OUTPUT:</span> <strong>MANUFACTURING-READY</strong>
                </div>
            </div> *@
        </div>
        </div>
    </section>