<!-- SECTION 04: HOW IT WORKS (CENTERED HEADER + CINEMATIC VIDEO STAGE) -->
<section class="copilot-section" id="copilot" aria-label="How the Copilot Works">
    <div class="wrap cp-center-container">
        
        <!-- Centered Header Block -->
        <div class="cp-head-block">
            <span class="eyebrow mono">HOW IT WORKS</span>
            <h2 class="cp-title">
                See how <span class="cp-accent-text">simple it is.</span>
            </h2>
            @* <p class="cp-desc">
                Enter your engineering requirements, let the copilot solve design relations, and get verified 3D models and manufacturing drawings automatically.
            </p> *@
            
            <!-- Impact Stat Pill -->
            <div class="cp-stat-pill mono">
                <span class="cp-stat-val">-85%</span>
                <span class="cp-stat-lbl">MANUAL DRAFTING &amp; REWORK ELIMINATED</span>
            </div>
        </div>

        <!-- Cinematic Video Showcase Stage -->
        <div class="glass-card cp-video-stage">
            <div class="cp-video-topbar">
                <div class="sim-title mono">
                    <span class="pulse-dot"></span> BELT CONVEYOR
                    <span class="sim-demo-badge mono">HD VIDEO</span>
                </div>
                <button type="button" class="cp-fullscreen-btn mono" id="cpBtnFullscreen"
                        aria-label="Expand video to fullscreen">
                    <i class="bi bi-arrows-fullscreen"></i>
                    <span>EXPAND FULLSCREEN</span>
                </button>
            </div>

            <div class="cp-video-frame">
                <video id="cpWorkflowVideo" class="cp-video-player" controls playsinline preload="metadata"
                       poster="/images/designfoundry_df_monogram.svg" style="width:100%; height:100%; 
                    object-fit:contain;">
                    <source src="/videos/Earth-rotates.mp4" type="video/mp4" />
                    <p class="mono text-muted" style="padding:20px;text-align:center;">
                        Your browser does not support HTML5 video.
                    </p>
                </video>
            </div>
        </div>

        <!-- CTA: Discuss your design flow -->
        <div class="cp-cta-block" style="display: flex; justify-content: center; margin-top: 36px;">
            <a href="@(Configuration["BookingSettings:MicrosoftBookingsUrl"] ?? "/contact")" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-calendar3"></i> Discuss your design flow
            </a>
        </div>

    </div>
</section>