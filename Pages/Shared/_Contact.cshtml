<!-- CONTACT (REAL CONTINENTS GLOBE + STACKED CARDS) -->
<section class="contact" id="contact">
    <div class="wrap">
        <div class="sec-head center">
            <p class="eyebrow mono" style="justify-content: center; display: flex;">Get in touch</p>
            <h2>Discuss your Copilot</h2>
