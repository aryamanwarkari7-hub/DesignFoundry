<!-- CONTACT (2-COLUMN 100VH CONSOLE: HEADING ON LEFT, EXPANDED CONSOLE ON RIGHT) -->
<section class="contact" id="contact" aria-label="Contact Engineering Team">
    <div class="wrap contact-grid-2col">
        <!-- LEFT COLUMN: HEADLINE, DYNAMIC INQUIRY BADGE & ACTIONS -->
        <div class="contact-left-copy">
            <div class="contact-title-group">
                <p class="eyebrow mono"><i class="bi bi-envelope-fill"></i> GET IN TOUCH</p>
                
                <!-- DYNAMIC INQUIRY CONTEXT BADGE (Appears when arriving from Product Modal) -->
                <div class="contact-inquiry-badge mono" id="contactInquiryBadge" style="display: none;">
                    <span class="pulse-dot"></span>
                    <span id="contactInquiryText">INQUIRY: CUSTOM COPILOT</span>
                </div>

                <h2>Discuss your<br><em>Copilot.</em></h2>
                <p class="contact-lead">
                    Tell us which CAD platform you use and what your team designs again and again.
                    We will show you how your own designs can be reused.
                </p>
            </div>

            <!-- Client Trust & Authority Strip (20+ | 100+ | 15+) -->
            <div class="contact-trust-strip mono" id="contactTrustStrip" aria-label="Aryaman Track Record">
                <div class="trust-item">
                    <span class="trust-pulse-dot" aria-hidden="true"></span>
                    <strong class="trust-num" data-target="20">0</strong><span class="trust-plus">+</span>
                    <span class="trust-lbl">Years Exp</span>
                </div>
                <span class="trust-sep" aria-hidden="true">&bull;</span>
                <div class="trust-item">
                    <strong class="trust-num" data-target="100">0</strong><span class="trust-plus">+</span>
                    <span class="trust-lbl">Clients</span>
                </div>
                <span class="trust-sep" aria-hidden="true">&bull;</span>
                <div class="trust-item">
                    <strong class="trust-num" data-target="15">0</strong><span class="trust-plus">+</span>
                    <span class="trust-lbl">Specialists</span>
                </div>
            </div>

            <!-- Primary Action CTAs -->
            <div class="contact-left-actions">
                <button type="button" class="btn btn-primary" id="btnOpenInquiryModal">
                    <i class="bi bi-envelope-arrow-up"></i> Discuss your Copilot
                </button>
                <a class="btn btn-ghost" href="https://www.aryamantechnologies.com" target="_blank" rel="noopener">
                    Visit Aryaman <i class="bi bi-arrow-up-right-circle-fill" style="font-size:15px"></i>
                </a>
            </div>

            @* <!-- Precision Telemetry Datum -->
            <div class="contact-hq-datum mono">
                <span class="pulse-dot"></span> HQ &bull; PUNE, INDIA (18.5204&deg; N, 73.8567&deg; E)
            </div> *@
        </div>

        <!-- RIGHT COLUMN: EXPANDED 21st.dev GLASS CONSOLE -->
        <div class="glass-card contact-console">
            <!-- LEFT CHAMBER: Real Continents 3D Globe with Exact Pune Pin -->
            <div class="globe-chamber">
                <div class="globe-telemetry-header">
                    <span class="globe-pill mono">
                        <span class="pulse-dot"></span> PUNE, IN
                    </span>
                    <span class="globe-coords mono">18.52&deg;N, 73.85&deg;E</span>
                </div>

                <div class="globe-canvas-wrap">
                    <canvas id="contactGlobeCanvas" width="400" height="400"></canvas>
                </div>

                <div class="globe-telemetry-footer mono">
                    <span class="globe-drag-hint">
                        <i class="bi bi-cursor-fill"></i> Drag globe
                    </span>
                    <button type="button" class="globe-spin-btn" id="globeSpinBtn" aria-label="Toggle globe spin">
                        <i class="bi bi-pause-fill" id="globeSpinIcon"></i>
                        <span id="globeSpinText">Pause</span>
                    </button>
                </div>
            </div>

            <!-- RIGHT CHAMBER: Contact Cards (Enlarged) -->
            <div class="contact-info-chamber">
                <div class="chamber-header">
                    <span class="chamber-badge mono">DIRECT ACCESS</span>
                    <h3 class="chamber-title">Connect with Engineering</h3>
                </div>

                <div class="contact-cards-grid">
                    <!-- CARD 1: General Email -->
                    <div class="contact-subcard">
                        <div class="card-meta mono">
                            <i class="bi bi-envelope"></i> General Enquiries
                        </div>
                        <a href="mailto:mail@aryamantechnologies.com" class="card-val card-link">mail@aryamantechnologies.com</a>
                        <div class="card-action">
                            <button class="copy" type="button" data-copy="mail@aryamantechnologies.com">
                                Copy Email
                            </button>
                        </div>
                    </div>

                    <!-- CARD 2: Leadership Email -->
                    <div class="contact-subcard">
                        <div class="card-meta mono">
                            <i class="bi bi-person-badge"></i> Direct Leadership
                        </div>
                        <a href="mailto:dhananjay@aryamantechnologies.com" class="card-val card-link">dhananjay@aryamantechnologies.com</a>
                        <div class="card-action">
                            <button class="copy" type="button" data-copy="dhananjay@aryamantechnologies.com">
                                Copy Email
                            </button>
                        </div>
                    </div>

                    <!-- CARD 3: Direct Phone -->
                    <div class="contact-subcard">
                        <div class="card-meta mono">
                            <i class="bi bi-telephone"></i> Office Direct (IST)
                        </div>
                        <a href="tel:+912025462557" class="card-val card-link">+91 20 2546 2557</a>
                        <div class="card-action">
                            <button class="copy" type="button" data-copy="+91 20 2546 2557">
                                Copy Phone
                            </button>
                        </div>
                    </div>

                    <!-- CARD 4: Headquarters Visit -->
                    <div class="contact-subcard">
                        <div class="card-meta mono">
                            <i class="bi bi-geo-alt"></i> Headquarters
                        </div>
                        <div class="card-val address">
                            Karvenagar, Pune &ndash; 411052, India
                        </div>
                        <div class="card-action">
                            <button class="copy" type="button"
                                    data-copy="S. No. 44, Plot No. 22, Navsahyadri Society, Near Tal Hospital, Karvenagar, Pune - 411052, Maharashtra, India">
                                Copy Address
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK INQUIRY GLASS MODAL -->
    <dialog id="inquiryDialog" class="inquiry-dialog" aria-labelledby="inquiryTitle">
        <div class="inquiry-box">
            <div class="inquiry-head">
                <div class="mono eyebrow"><span class="pulse-dot"></span> DIRECT ENGINEERING INQUIRY</div>
                <h3 id="inquiryTitle">Discuss your Copilot</h3>
                <button type="button" class="pd-x" id="inquiryClose" aria-label="Close dialog">&times;</button>
            </div>
            
            <div class="inquiry-body">
                <div class="inquiry-field">
                    <label class="mono">01 : YOUR CAD PLATFORM</label>
                    <div class="inquiry-cad-chips">
                        <button type="button" class="cad-chip active" data-cad="SolidWorks">SolidWorks</button>
                        <button type="button" class="cad-chip" data-cad="Autodesk Inventor">Inventor</button>
                        <button type="button" class="cad-chip" data-cad="PTC Creo">PTC Creo</button>
                        <button type="button" class="cad-chip" data-cad="Siemens NX">Siemens NX</button>
                    </div>
                </div>

                <div class="inquiry-field">
                    <label class="mono" for="inquiryEquipment">02 : EQUIPMENT / PRODUCT TO AUTOMATE</label>
                    <input type="text" id="inquiryEquipment" class="inquiry-input"
                           placeholder="e.g. Centrifugal Fan, Conveyor, Heat Exchanger..." />
                </div>

                <div class="inquiry-field">
                    <label class="mono" for="inquiryEmail">03 : YOUR WORK EMAIL</label>
                    <input type="email" id="inquiryEmail" class="inquiry-input"
                           placeholder="engineer@company.com" />
                </div>
            </div>

            <div class="inquiry-foot">
                <a href="#" id="btnSendInquiryEmail" class="btn btn-primary">
                    <i class="bi bi-send"></i> Send Inquiry via Email
                </a>
                <button type="button" class="pd-copy-btn" id="btnCopyInquiryDraft">
                    <i class="bi bi-clipboard"></i> Copy Draft for Webmail
                </button>
            </div>
            </div
        </div>
    </dialog>
</section>