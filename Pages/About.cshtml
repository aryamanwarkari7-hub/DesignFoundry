@page
@{
    ViewData["Title"] = "About Aryaman Technologies - Industrial Engineering Foundation";
}

<div class="standalone-page-wrap">
    <!-- 1. The 13 Industrial Engines Section -->
    <partial name="_Foundation" />

    <!-- 2. Action Closer Card (Eliminates dead-end) -->
    <section class="page-closer-section" aria-label="Next steps">
        <div class="wrap">
            <div class="page-closer-card glass-card">
                <div class="closer-header">
                    <p class="eyebrow mono"><i class="bi bi-lightning-charge-fill"></i> NEXT STEP &bull; DEPLOY ON YOUR ARCHIVES</p>
                    <h2>Need custom design automation for your equipment?</h2>
                    <p>Every copilot is configured for your team’s proprietary CAD files and engineering rules. See how your own historical archives can be automated.</p>
                </div>
                <div class="closer-actions">
                    <a class="btn btn-primary" href="/#contact">
                        <i class="bi bi-envelope-arrow-up"></i> Discuss your Copilot &rarr;
                    </a>
                    <a class="btn btn-ghost" href="/#copilot">
                        <i class="bi bi-cpu"></i> Test Live Simulator
                    </a>
                </div>
                <div class="closer-meta mono">
                    <span><span class="pulse-dot"></span> WORKS WITH SOLIDWORKS &bull; INVENTOR &bull; CREO &bull; NX</span>
                </div>
            </div>
        </div>
    </section>
</div>